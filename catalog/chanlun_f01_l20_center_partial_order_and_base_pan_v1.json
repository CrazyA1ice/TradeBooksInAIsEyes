  "author_l20_conditional_formulas": [
    {
      "id": "L20-STRICT-UP",
      "formula": "later.DD > earlier.GG",
      "logical_output": "STRICT_UP_SEPARATED",
      "claimed_role": "author theorem two upward strict separation"
    },
    {
      "id": "L20-STRICT-DOWN",
      "formula": "later.GG < earlier.DD",
      "logical_output": "STRICT_DOWN_SEPARATED",
      "claimed_role": "author theorem two downward strict separation"
    },
    {
      "id": "L20-UP-EXPANSION",
      "formula": "later.ZD > earlier.ZG AND later.DD <= earlier.GG",
      "logical_output": "UPWARD_EXPANSION_PATTERN",
      "claimed_role": "author theorem two upward expansion"
    },
    {
      "id": "L20-DOWN-EXPANSION",
      "formula": "later.ZG < earlier.ZD AND later.GG >= earlier.DD",
      "logical_output": "DOWNWARD_EXPANSION_PATTERN",
      "claimed_role": "author theorem two downward expansion"
    }

  "source_notation": {
    "GG": "max(g_n) among author-defined Z move segments of same center",
    "DD": "min(d_n) among author-defined Z move segments of same center",
    "ZG": "min(g1,g2) center overlap upper boundary",
    "ZD": "max(d1,d2) center overlap lower boundary",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chanlun Synthetic Closed-Bar Prefix Input v1",
  "description": "Read-only experiment fixture; a closed bar must not be known before bar end. Runtime enforces temporal and OHLCV invariants that JSON Schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "explanation",
    "bars"
  ],
  "properties": {
    "kind": {
      "const": "synthetic_non_market_fixture"
    },
    "explanation": {
      "type": "string",
      "minLength": 10
    },
    "bars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "symbol",
          "timeframe",
          "seq",
          "start_at",
          "end_at",
          "known_at",
          "open",
          "high",
          "low",
          "close",
          "volume",
          "is_closed",
          "source_revision_sha256"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "timeframe": {
            "type": "string",
            "minLength": 1
          },
          "start_at": {
            "type": "string",
            "minLength": 1
          },
          "end_at": {
            "type": "string",
            "minLength": 1
          },
          "known_at": {
            "type": "string",
            "minLength": 1
          },
          "open": {
            "type": "string",
            "minLength": 1
          },
          "high": {
            "type": "string",
            "minLength": 1
          },
          "low": {
            "type": "string",
            "minLength": 1
          },
          "close": {
            "type": "string",
            "minLength": 1
          },
          "volume": {
            "type": "string",
            "minLength": 1
          }
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "is_closed": {
          "type": "boolean"
        },
        "source_revision_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
